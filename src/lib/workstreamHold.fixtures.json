  "free": [
    {
      "name": "a review that sent a fix round is free",
      "events": [],
      "facts": [{"run": "rev1", "fixRound": true}],
      "expect": true
    },
    {
      "name": "a build the rules sent back for a fix round is free when it finishes",
      "events": [
        {"action": "autostart", "runId": "b1", "detail": "fix_round after rev1"}
      ],
      "facts": [{"run": "b1"}],
      "expect": true
    },
    {
      "name": "a build no fix round was sent is a step",
      "events": [
        {"action": "autostart", "runId": "b1", "detail": "fix_round after rev1"}
      ],
      "facts": [{"run": "b2"}],
      "expect": false
    },
    {
      "name": "a finished build with nothing in the audit is a step",
      "events": [],
      "facts": [{"run": "b1"}],
      "expect": false
    },
    {
      "name": "a plain review is a step",
      "events": [],
      "facts": [{"run": "rev1"}],
      "expect": false
    },
    {
      "name": "a free fact beside a step is a step",
      "events": [
        {"action": "autostart", "runId": "b1", "detail": "fix_round after rev1"}
      ],
      "facts": [{"run": "b1"}, {"run": "inv1"}],
      "expect": false
    },
    {
      "name": "a fix-round review beside its build is free",
      "events": [
        {"action": "autostart", "runId": "b1", "detail": "fix_round after rev1"}
      ],
      "facts": [{"run": "rev2", "fixRound": true}, {"run": "b1"}],
      "expect": true
    },
    {
      "name": "a fix-round review beside another run is a step",
      "events": [],
      "facts": [{"run": "rev2", "fixRound": true}, {"run": "inv1"}],
      "expect": false
    },
    {
      "name": "an autostart line for another rule does not free the run",
      "events": [
        {"action": "autostart", "runId": "b1", "detail": "triage_plan after t1"}
      ],
      "facts": [{"run": "b1"}],
      "expect": false
    },
    {
      "name": "an autostart line of a person's fix round is not the rules'",
