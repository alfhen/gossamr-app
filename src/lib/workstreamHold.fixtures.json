  "sequences": [
    {
      "name": "Advise, Resume, Manage asks the question again with the count unchanged",
      "start": {"mode": "manage", "held": "budget", "spent": {"autoTurns": 11, "wakes": 9}},
      "steps": [
        {"do": "setMode", "mode": "advise", "actor": "person", "expect": {"state": {"mode": "advise", "held": "budget", "limits": [11, 12], "level": "spent"}, "events": [["person", "mode_set", "advise"]]}},
        {"do": "resume", "expect": {"state": {"mode": "advise", "held": null, "limits": [11, 12], "level": "spent"}, "events": [["person", "resumed", "budget"]]}},
        {"do": "setMode", "mode": "manage", "actor": "person", "expect": {"state": {"mode": "manage", "held": "budget", "limits": [11, 12], "level": "spent"}, "events": [["person", "mode_set", "manage"], ["supervisor", "held", "budget"]]}},
        {"do": "allowMore", "expect": {"state": {"mode": "manage", "held": null, "limits": [16, 17], "level": "ok"}, "events": [["person", "steps_allowed", "5"], ["person", "resumed", "budget"]]}}
      ]
    },
    {
      "name": "Allow 5 more lifts the hold and raises both allowances, keeping what was spent",
