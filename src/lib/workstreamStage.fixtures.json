[
  {
    "name": "no runs is intake",
    "runs": [],
    "stage": "intake"
  },
  {
    "name": "a queued investigation is investigate",
    "runs": [{ "role": "investigate", "state": "queued", "queuedAt": "2026-09-29T10:00:00Z" }],
    "stage": "investigate"
  },
  {
    "name": "a finished investigation alone stays investigate",
    "runs": [{ "role": "investigate", "state": "done", "queuedAt": "2026-09-29T10:00:00Z" }],
    "stage": "investigate"
  },
  {
    "name": "investigate done then triage working is triage",
    "runs": [
      { "role": "investigate", "state": "done", "queuedAt": "2026-09-29T10:00:00Z" },
      { "role": "triage", "state": "working", "queuedAt": "2026-09-29T11:00:00Z" }
    ],
    "stage": "triage"
  },
  {
    "name": "plan working while an investigation failed is plan",
    "runs": [
      { "role": "investigate", "state": "failed", "queuedAt": "2026-09-29T10:00:00Z" },
      { "role": "plan", "state": "working", "queuedAt": "2026-09-29T11:00:00Z" }
    ],
    "stage": "plan"
  },
  {
    "name": "a failed run after a finished one does not hold the stage back",
    "runs": [
      { "role": "triage", "state": "done", "queuedAt": "2026-09-29T10:00:00Z" },
      { "role": "investigate", "state": "failed", "queuedAt": "2026-09-29T11:00:00Z" }
    ],
    "stage": "triage"
  },
  {
    "name": "an earlier kind in progress wins over a later kind that finished",
    "runs": [
      { "role": "plan", "state": "done", "queuedAt": "2026-09-29T10:00:00Z" },
      { "role": "investigate", "state": "launching", "queuedAt": "2026-09-29T11:00:00Z" }
    ],
    "stage": "investigate"
  },
  {
    "name": "a build waiting on an answer is build",
    "runs": [
      { "role": "plan", "state": "done", "queuedAt": "2026-09-29T10:00:00Z" },
      { "role": "build", "state": "needsAnswer", "queuedAt": "2026-09-29T11:00:00Z" }
    ],
    "stage": "build"
  },
  {
    "name": "a build waiting on permission is build",
    "runs": [{ "role": "build", "state": "needsPermission", "queuedAt": "2026-09-29T11:00:00Z" }],
    "stage": "build"
  },
  {
    "name": "a review in progress is review",
    "runs": [
      { "role": "build", "state": "done", "queuedAt": "2026-09-29T10:00:00Z" },
      { "role": "review", "state": "systemBlocked", "queuedAt": "2026-09-29T11:00:00Z" }
    ],
    "stage": "review"
  },
  {
    "name": "a finished review that passed is done",
    "runs": [
      { "role": "build", "state": "done", "queuedAt": "2026-09-29T10:00:00Z" },
      { "role": "review", "state": "done", "queuedAt": "2026-09-29T11:00:00Z", "verdict": "pass" }
    ],
    "stage": "done"
  },
  {
    "name": "a finished review that is blocking is review, changes needed",
    "runs": [
      { "role": "build", "state": "done", "queuedAt": "2026-09-29T10:00:00Z" },
      { "role": "review", "state": "done", "queuedAt": "2026-09-29T11:00:00Z", "verdict": "blocking" }
    ],
    "stage": "review",
    "reviewBlocking": true
  },
  {
    "name": "a blocking review then a newer passing one is done",
    "runs": [
      { "role": "review", "state": "done", "queuedAt": "2026-09-29T11:00:00Z", "verdict": "blocking" },
      { "role": "review", "state": "done", "queuedAt": "2026-09-29T12:00:00Z", "verdict": "pass" }
    ],
    "stage": "done"
  },
  {
    "name": "a passing review then a newer blocking one is review",
    "runs": [
      { "role": "review", "state": "done", "queuedAt": "2026-09-29T11:00:00Z", "verdict": "pass" },
      { "role": "review", "state": "done", "queuedAt": "2026-09-29T12:00:00Z", "verdict": "blocking" }
    ],
    "stage": "review",
    "reviewBlocking": true
  },
  {
    "name": "a finished review with no verdict is review",
    "runs": [
      { "role": "build", "state": "done", "queuedAt": "2026-09-29T10:00:00Z" },
      { "role": "review", "state": "done", "queuedAt": "2026-09-29T11:00:00Z" }
    ],
    "stage": "review"
  },
  {
    "name": "a finished verification after a blocking review is done",
    "runs": [
      { "role": "review", "state": "done", "queuedAt": "2026-09-29T11:00:00Z", "verdict": "blocking" },
      { "role": "verify", "state": "done", "queuedAt": "2026-09-29T12:00:00Z" }
    ],
    "stage": "done"
  },
  {
    "name": "a review working after a blocking review is review",
    "runs": [
      { "role": "review", "state": "done", "queuedAt": "2026-09-29T11:00:00Z", "verdict": "blocking" },
      { "role": "review", "state": "working", "queuedAt": "2026-09-29T12:00:00Z" }
    ],
    "stage": "review"
  },
  {
    "name": "a verification in progress is verify",
    "runs": [{ "role": "verify", "state": "working", "queuedAt": "2026-09-29T11:00:00Z" }],
    "stage": "verify"
  },
  {
    "name": "a finished verification is done",
    "runs": [
      { "role": "investigate", "state": "done", "queuedAt": "2026-09-29T10:00:00Z" },
      { "role": "verify", "state": "done", "queuedAt": "2026-09-29T11:00:00Z" }
    ],
    "stage": "done"
  },
  {
    "name": "all stopped falls back to the kind of the last queued run",
    "runs": [
      { "role": "plan", "state": "stopped", "queuedAt": "2026-09-29T10:00:00Z" },
      { "role": "triage", "state": "failed", "queuedAt": "2026-09-29T12:00:00Z" },
      { "role": "investigate", "state": "stopped", "queuedAt": "2026-09-29T11:00:00Z" }
    ],
    "stage": "triage"
  },
  {
    "name": "unknown counts as in progress",
    "runs": [
      { "role": "review", "state": "done", "queuedAt": "2026-09-29T10:00:00Z" },
      { "role": "triage", "state": "unknown", "queuedAt": "2026-09-29T11:00:00Z" }
    ],
    "stage": "triage"
  },
  {
    "name": "timestamps with and without fractions order by time, not text",
    "runs": [
      { "role": "investigate", "state": "failed", "queuedAt": "2026-09-29T10:00:05.500Z" },
      { "role": "triage", "state": "failed", "queuedAt": "2026-09-29T10:00:05Z" }
    ],
    "stage": "investigate",
    "labels": ["R2", "R1"]
  },
  {
    "name": "timestamps that differ below a millisecond order by time",
    "runs": [
      { "role": "plan", "state": "stopped", "queuedAt": "2026-09-29T10:00:05.120100000Z" },
      { "role": "build", "state": "failed", "queuedAt": "2026-09-29T10:00:05.120Z" }
    ],
    "stage": "plan",
    "labels": ["R2", "R1"]
  },
  {
    "name": "the same instant written two ways ties, and the id decides",
    "runs": [
      { "role": "triage", "state": "failed", "queuedAt": "2026-09-29T10:00:05.120000Z" },
      { "role": "investigate", "state": "failed", "queuedAt": "2026-09-29T10:00:05.120Z" }
    ],
    "stage": "investigate",
    "labels": ["R1", "R2"]
  },
  {
    "name": "the -er names count as their step",
    "runs": [
      { "role": "planner", "state": "done", "queuedAt": "2026-09-29T10:00:00Z" },
      { "role": "builder", "state": "done", "queuedAt": "2026-09-29T11:00:00Z" },
      { "role": "reviewer", "state": "working", "queuedAt": "2026-09-29T12:00:00Z" }
    ],
    "stage": "review"
  },
  {
    "name": "a role that names no step counts as a build",
    "runs": [
      { "role": "planner", "state": "done", "queuedAt": "2026-09-29T10:00:00Z" },
      { "role": "code auditor", "state": "working", "queuedAt": "2026-09-29T11:00:00Z" }
    ],
    "stage": "build"
  }
]
